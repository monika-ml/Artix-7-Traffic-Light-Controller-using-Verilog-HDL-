
## 100 MHz Clock
set_property -dict { PACKAGE_PIN E3 IOSTANDARD LVCMOS33 } [get_ports clk]

create_clock -add -name sys_clk_pin \
-period 10.00 -waveform {0 5} [get_ports clk]

## Reset Button
set_property -dict { PACKAGE_PIN U18 IOSTANDARD LVCMOS33 } [get_ports reset]

## North-South Traffic Lights
## Red LED
set_property -dict { PACKAGE_PIN H17 IOSTANDARD LVCMOS33 } [get_ports ns_red]

## Yellow LED
set_property -dict { PACKAGE_PIN K15 IOSTANDARD LVCMOS33 } [get_ports ns_yellow]

## Green LED
set_property -dict { PACKAGE_PIN J13 IOSTANDARD LVCMOS33 } [get_ports ns_green]

## East-West Traffic Lights
## Red LED
set_property -dict { PACKAGE_PIN N14 IOSTANDARD LVCMOS33 } [get_ports ew_red]

## Yellow LED
set_property -dict { PACKAGE_PIN R18 IOSTANDARD LVCMOS33 } [get_ports ew_yellow]

## Green LED
set_property -dict { PACKAGE_PIN V17 IOSTANDARD LVCMOS33 } [get_ports ew_green]
