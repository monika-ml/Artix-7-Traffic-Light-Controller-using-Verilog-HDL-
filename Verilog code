
`timescale 1ns / 1ps

module traffic_light #(
    parameter integer CLK_FREQ_HZ = 100_000_000,
    parameter integer GREEN_SECONDS = 10,
    parameter integer YELLOW_SECONDS = 3
)(
    input wire clk,
    input wire reset,

    output reg ns_red,
    output reg ns_yellow,
    output reg ns_green,

    output reg ew_red,
    output reg ew_yellow,
    output reg ew_green
);

    // FSM states
    parameter NS_GREEN  = 2'b00;
    parameter NS_YELLOW = 2'b01;
    parameter EW_GREEN  = 2'b10;
    parameter EW_YELLOW = 2'b11;

    reg [1:0] state;
    integer count;
    integer duration;

    // State transition logic
    always @(posedge clk) begin
        if (reset) begin
            state <= NS_GREEN;
            count <= 0;
        end
        else begin

            if (state == NS_GREEN || state == EW_GREEN)
                duration = CLK_FREQ_HZ * GREEN_SECONDS;
            else
                duration = CLK_FREQ_HZ * YELLOW_SECONDS;

            if (count >= duration - 1) begin
                count <= 0;
                state <= state + 1'b1;
            end
            else begin
                count <= count + 1;
            end
        end
    end

    // Output logic
    always @(*) begin

        ns_red    = 1'b1;
        ns_yellow = 1'b0;
        ns_green  = 1'b0;

        ew_red    = 1'b1;
        ew_yellow = 1'b0;
        ew_green  = 1'b0;

        case (state)

            NS_GREEN: begin
                ns_red   = 1'b0;
                ns_green = 1'b1;
            end

            NS_YELLOW: begin
                ns_red    = 1'b0;
                ns_yellow = 1'b1;
            end

            EW_GREEN: begin
                ew_red   = 1'b0;
                ew_green = 1'b1;
            end

            EW_YELLOW: begin
                ew_red    = 1'b0;
                ew_yellow = 1'b1;
            end

            default: begin
                ns_red = 1'b1;
                ew_red = 1'b1;
            end

        endcase
    end

endmodule
